# Every text file is LF in the working tree on every machine (also on Windows with core.autocrlf=true),
# so agents and editors never see CRLF copies and a rewrite never produces a whole-file diff.
* text=auto eol=lf

# Windows batch files: cmd.exe can misread LF batch files, so they are CRLF in the working tree.
*.cmd text eol=crlf
*.bat text eol=crlf
